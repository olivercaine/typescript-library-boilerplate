{
  "compilerOptions": {
    "target": "es5", // Target es5 for IE9/10
    "module": "commonjs", // https://www.typescriptlang.org/tsconfig#module
    "sourceMap": true, // Enables the generation of sourcemap files.
    "emitDecoratorMetadata": true, // Enables experimental support for emitting type metadata for decorators which works with the module reflect-metadata.
    "experimentalDecorators": true, // https://www.typescriptlang.org/tsconfig#experimentalDecorators
    "strictNullChecks": true, // When strictNullChecks is true, null and undefined have their own distinct types and you’ll get a type error if you try to use them where a concrete value is expected.
    "declaration": true, // Generate .d.ts files for every TypeScript or JavaScript file inside your project. These .d.ts files are type definition files which describe the external API of your module.
    "noUnusedParameters": true, // Report errors on unused parameters in functions.
    "noImplicitAny": true, // Turning on noImplicitAny however TypeScript will issue an error whenever it would have inferred any:
    "outDir": "./dist", // If specified, .js (as well as .d.ts, .js.map, etc.) files will be emitted into this directory. 
    "removeComments": true, // Strips all comments from TypeScript files when converting into JavaScript.
    "lib": [
      "es2015"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules"
    ],
    "types": [
      "node",
      "mocha",
      "chai"
    ]
  },
  "files": [
    "src/index.ts"
  ]
}